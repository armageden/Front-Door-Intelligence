# Environment template for Front Door Intelligence.
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
# Never commit a real credential — NFR3 requires all keys and tokens to live in
# environment variables only.
#
# Variable names and example values are reproduced from ARCHITECTURE.md §8.2.
# AWS_REGION and BEDROCK_MODEL_ID are consumed by the AWS SDK, which reads them
# directly; the RING_*, DYNAMODB_*, S3_*, QUERY_* and WEBSOCKET_* values are read
# by application code. Every value below is a placeholder.

# --- Ring Partner API (ARCHITECTURE.md §3.1, §3.2) ---
RING_CLIENT_ID=your_ring_client_id
RING_CLIENT_SECRET=your_ring_client_secret
RING_REFRESH_TOKEN=your_refresh_token
# Shared secret for the X-Signature HMAC-SHA256 webhook check (FR2).
RING_WEBHOOK_SECRET=your_webhook_hmac_secret

# --- AWS (ARCHITECTURE.md §8.2) ---
AWS_REGION=us-east-1
# ARCHITECTURE.md §3.3 offers anthropic.claude-3-haiku or amazon.nova-lite-v1.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- DynamoDB (ARCHITECTURE.md §3.5) ---
DYNAMODB_EVENTS_TABLE=FrontDoorEvents
DYNAMODB_IDEMPOTENCY_TABLE=FrontDoorIdempotency

# --- S3 snapshot storage (ARCHITECTURE.md §3.5, §6) ---
S3_SNAPSHOT_BUCKET=front-door-snapshots

# --- Ingress → describe hand-off (src/lib/snapshotStore.ts) ---
# The SQS queue URL, as emitted by the `DescribeDeadLetterQueueUrl` sibling output.
# The webhook handler skips the hand-off when this is unset, so the event is stored
# with no description rather than the request failing.
EVENT_QUEUE_URL=your_sqs_queue_url

# --- Event query (src/handlers/eventQuery.ts) ---
# Shared key guarding GET /events/today, sent as the X-Query-Key header.
# ARCHITECTURE.md §5.2 specifies the endpoint without naming an auth mechanism;
# this is the minimum that keeps a homeowner's door activity private. Decision D022.
QUERY_API_KEY=your_query_api_key

# --- Overlay delivery (src/handlers/overlayPusher.ts) ---
# WebSocket connection registry, written on $connect and pruned on $disconnect.
CONNECTIONS_TABLE=FrontDoorConnections
# API Gateway Management API endpoint, as emitted by the OverlayWebSocketUrl output.
# Must be the https:// form: this is what PostToConnection posts against.
WEBSOCKET_ENDPOINT=https://your-api-id.execute-api.your-region.amazonaws.com/prod
