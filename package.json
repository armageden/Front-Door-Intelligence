{
  "name": "front-door-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Amazon Developer Hackathon 2026 (Ring track) \u2014 turn front-door motion events into one-sentence AI descriptions on a Fire TV overlay.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docs:check": "node scripts/docs-check.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:web && npm run typecheck:firetv",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json && npm run typecheck:pipeline",
    "typecheck:firetv": "tsc --noEmit -p firetv/tsconfig.json",
    "build": "node scripts/build-lambda.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:firetv": "node scripts/build-firetv.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:verify": "node scripts/verify-bundle.mjs",
    "all": "npm run typecheck && npm test && npm run build && npm run build:verify && npm run build:web && npm run build:firetv && npm run docs:check",
    "typecheck:pipeline": "tsc --noEmit -p web/tsconfig.pipeline.json",
    "coverage:gaps": "node scripts/coverage-gaps.mjs"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1141.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1141.0",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-sqs": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0"
  }
}
